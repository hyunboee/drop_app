{
  "name": "drop-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "test": "node --env-file=.env.test --test --test-concurrency=1 --experimental-test-coverage --test-coverage-lines=90 --test-coverage-exclude=\"test/**\" \"test/**/*.test.js\""
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1144.0",
    "@aws-sdk/client-s3": "^3.1144.0",
    "@aws-sdk/s3-request-presigner": "^3.1144.0",
    "express": "^5.2.1",
    "pg": "^8.23.1"
  }
}
